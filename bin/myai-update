#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JAVA_BIN="${JAVA_BIN:-java}"
JAR_PATH="${PROJECT_ROOT}/target/myapp-0.1.0.jar"

echo "myai-update: checking for updates..."
if [[ -f "$JAR_PATH" ]]; then
  echo "myai is installed at $JAR_PATH"
else
  echo "myai is not installed. Run ./install.sh first."
fi
