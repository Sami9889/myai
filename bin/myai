#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JAVA_BIN="${JAVA_BIN:-java}"
JAR="${PROJECT_ROOT}/target/myai-0.1.0.jar"

if [[ -f "$JAR" ]]; then
  exec "$JAVA_BIN" -jar "$JAR" "$@"
else
  exec "$JAVA_BIN" -cp "$PROJECT_ROOT/target/classes" com.myai.cli.Repl "$@"
fi
